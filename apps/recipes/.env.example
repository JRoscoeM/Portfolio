DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://recipes.example.com
DJANGO_TIME_ZONE=America/Denver

# Leave unset for local SQLite. Use Neon's pooled connection string in Vercel.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
