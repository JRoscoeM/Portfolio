# Neon connection string. Keep this server-side; never prefix it with VITE_ or NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# At least 32 random bytes, used to sign the HttpOnly session cookie.
TRACKER_SESSION_SECRET=replace-with-a-long-random-secret

# Sign-in uses OAuth and sign-up is open. Configure Google, GitHub, or both; a provider is offered
# when its client id and secret are set. Register <origin>/api/tracker/auth as the redirect/callback URL.
TRACKER_GOOGLE_CLIENT_ID=
TRACKER_GOOGLE_CLIENT_SECRET=
TRACKER_GITHUB_CLIENT_ID=
TRACKER_GITHUB_CLIENT_SECRET=

# Optional. The account that keeps the original "owner" data: a verified Google address and/or a
# GitHub numeric account id (the "id" field at https://api.github.com/users/<your-login>).
# Every other account gets its own new, empty tracker.
TRACKER_OWNER_GOOGLE_EMAIL=
TRACKER_OWNER_GITHUB_ID=

# Optional. Public origin used to build the OAuth redirect URL, e.g. https://example.com.
# Defaults to the request's host, which is fine for a single domain and for localhost.
TRACKER_PUBLIC_ORIGIN=
