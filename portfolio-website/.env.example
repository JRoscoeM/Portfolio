# Neon connection string. Keep this server-side; never prefix it with VITE_ or NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Personal owner sign-in. Use a long passphrase even for this lightweight MVP.
TRACKER_OWNER_PASSCODE=replace-with-a-long-passphrase

# At least 32 random bytes, used to sign the HttpOnly owner session cookie.
TRACKER_SESSION_SECRET=replace-with-a-long-random-secret
