	@test -d $(INSTALL_ROOT)/opt/A7/bin || mkdir -p $(INSTALL_ROOT)/opt/A7/bin
	$(QINSTALL_PROGRAM) /Users/roscoe/Documents/Portfolio_Projects/SpriteReal/a5-sprite-editor-f25-jeniene-saoit/A7/A7.js $(INSTALL_ROOT)/opt/A7/bin/A7.js

uninstall_js_file: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/A7/bin/A7.js
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/A7/bin/ 


install: install_target install_js_file  FORCE

uninstall: uninstall_target uninstall_js_file  FORCE

FORCE:

