A7.app/Contents/PkgInfo: 
	@test -d A7.app/Contents || mkdir -p A7.app/Contents
	@$(DEL_FILE) A7.app/Contents/PkgInfo
	@echo "APPL????" > A7.app/Contents/PkgInfo
A7.app/Contents/Info.plist: 
	@test -d A7.app/Contents || mkdir -p A7.app/Contents
	@$(DEL_FILE) A7.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - /Users/roscoe/Qt/6.9.3/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.A7,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.A7,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},12,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,A7,g" -e "s,@LIBRARY@,A7,g" -e "s,\$${EXECUTABLE_NAME},A7,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >A7.app/Contents/Info.plist

