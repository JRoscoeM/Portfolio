install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/A7/bin || mkdir -p $(INSTALL_ROOT)/opt/A7/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/A7/bin/A7.app
	
	$(QINSTALL) A7.app $(INSTALL_ROOT)/opt/A7/bin/A7.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/A7/bin/A7.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/A7/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

